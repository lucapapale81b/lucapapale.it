---
import BaseLayout from '../layouts/BaseLayout.astro';

const travelSummary = [
  { label: 'Paesi visitati', value: '17' },
  { label: 'Continenti', value: '4' },
  { label: 'Città preferita', value: 'Londra' },
  { label: 'Viaggio che mi ha cambiato di più', value: 'Argentina' },
];
---

<BaseLayout
  title="Viaggi | Luca Papale"
  description="I viaggi di Luca Papale: luoghi, fotografie ed esperienze."
>
  <section class="travels-intro" aria-labelledby="travels-title">
    <div class="container">
      <h1 id="travels-title">Viaggi</h1>

      <dl class="travels-intro__summary">
        {
          travelSummary.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .travels-intro {
    padding-block: var(--space-section);
  }

  .travels-intro__summary {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-8);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .travels-intro__summary > div {
    display: grid;
    gap: var(--space-1);
    padding-block-start: var(--space-5);
  }

  .travels-intro__summary dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .travels-intro__summary dd {
    color: var(--color-primary);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-heading);
  }

  @media (min-width: 48rem) {
    .travels-intro__summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-7);
    }
  }

  @media (min-width: 64rem) {
    .travels-intro__summary {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
