---
import { Image } from 'astro:assets';
import heroImage from '../assets/perito-moreno.png';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__content">
      <h1 id="hero-title">Ciao, sono Luca.</h1>

      <p class="hero__lead">
        Sono uno sviluppatore backend e questo è il luogo in cui raccolgo il
        mio percorso professionale, ciò che imparo costruendo software e i
        progetti su cui lavoro. Fuori dal codice, racconto i viaggi, le
        fotografie e le esperienze che ampliano il mio punto di vista.
      </p>

      <div class="hero__actions">
        <a class="hero__button hero__button--primary" href="#">
          Scopri il mio percorso
        </a>
        <a class="hero__button hero__button--secondary" href="#">
          Esplora i miei viaggi
        </a>
      </div>
    </div>

    <figure class="hero__media">
      <Image
        src={heroImage}
        alt="Luca osserva il ghiacciaio Perito Moreno dalla barca"
        widths={[480, 640]}
        sizes="(min-width: 64rem) 40vw, 100vw"
        format="webp"
        quality={85}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(var(--space-7), 7vw, var(--space-9));
  }

  .hero__inner {
    display: grid;
    gap: var(--space-7);
  }

  .hero__content {
    display: grid;
    max-inline-size: var(--content-narrow);
    align-content: center;
  }

  .hero__lead {
    max-inline-size: 38rem;
    margin-block-start: var(--space-5);
    font-size: var(--font-size-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .hero__button {
    display: inline-flex;
    min-block-size: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-5);
    border: var(--border-width) solid var(--color-primary);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
    text-align: center;
    text-decoration: none;
  }

  .hero__button--primary {
    background: var(--color-primary);
    color: var(--color-surface);
  }

  .hero__button--primary:hover {
    border-color: var(--color-primary-hover);
    background: var(--color-primary-hover);
    color: var(--color-surface);
  }

  .hero__button--secondary {
    background: transparent;
    color: var(--color-primary);
  }

  .hero__button--secondary:hover {
    background: var(--color-primary-soft);
    color: var(--color-primary-hover);
  }

  .hero__media {
    inline-size: min(100%, 34rem);
    aspect-ratio: 1;
    justify-self: center;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .hero__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  @media (min-width: 30rem) {
    .hero__actions {
      gap: var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-block: clamp(var(--space-8), 8vw, var(--space-9));
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
      gap: clamp(var(--space-7), 7vw, var(--space-9));
      align-items: center;
    }

    .hero__media {
      aspect-ratio: 5 / 6;
      justify-self: end;
    }
  }
</style>
