---
interface Props {
  continent: string;
  year?: number;
  duration?: string;
  stops?: Array<unknown>;
}

const { continent, year, duration, stops = [] } = Astro.props;
const facts = [
  ...(duration ? [{ label: 'Durata', value: duration }] : []),
  ...(stops.length
    ? [{ label: 'Tappe principali', value: String(stops.length) }]
    : []),
  ...(year ? [{ label: 'Periodo', value: String(year) }] : []),
  { label: 'Continente', value: continent },
];
---

<section class="travel-facts" aria-labelledby="travel-facts-title">
  <div class="container--wide">
    <h2 id="travel-facts-title">Il viaggio in numeri</h2>

    <dl>
      {
        facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .travel-facts {
    padding-block: var(--space-7);
    background: var(--color-background-subtle);
  }

  .travel-facts h2 {
    font-size: var(--font-size-2xl);
  }

  .travel-facts dl {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-6);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .travel-facts dl > div {
    display: grid;
    gap: var(--space-1);
    padding-block-start: var(--space-4);
  }

  .travel-facts dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .travel-facts dd {
    color: var(--color-primary);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
  }

  @media (min-width: 48rem) {
    .travel-facts dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-7);
    }
  }

  @media (min-width: 64rem) {
    .travel-facts dl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
