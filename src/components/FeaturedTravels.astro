---
import TravelCard from './TravelCard.astro';
import { getFeaturedTravels } from '../utils/travels';

const travels = await getFeaturedTravels();
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section class="featured-travels" aria-labelledby="featured-travels-title">
  <div class="container">
    <header class="featured-travels__header">
      <h2 id="featured-travels-title">Grandi viaggi</h2>
      <p>
        Alcuni viaggi, più di altri, hanno lasciato un segno. Sono quelli in cui
        il paesaggio, il tempo e le esperienze hanno cambiato il mio modo di
        guardare il mondo.
      </p>
    </header>

    <div class="featured-travels__grid">
      {
        travels.map(({ data }) => (
          <TravelCard
            title={data.title}
            subtitle={data.subtitle}
            description={data.summary}
            image={data.cover}
            imageAlt={data.coverAlt}
            href={`${baseUrl}viaggi/${data.slug}`}
            countryCode={data.countryCode}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .featured-travels {
    padding-block: var(--space-section);
  }

  .featured-travels__header {
    max-inline-size: var(--content-narrow);
  }

  .featured-travels__header p {
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .featured-travels__grid {
    display: grid;
    gap: var(--space-8);
    margin-block-start: var(--space-8);
  }

  @media (min-width: 48rem) {
    .featured-travels__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-6);
    }
  }

  @media (min-width: 64rem) {
    .featured-travels__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-7);
    }
  }
</style>
