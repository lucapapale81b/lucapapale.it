---
import worldMapRaw from '../assets/maps/world.svg?raw';

interface Props {
  stops: Array<{ name: string; slug: string }>;
}

const { stops } = Astro.props;
const argentinaMatch = worldMapRaw.match(/<g id="ar"[\s\S]*?<\/g>/);

if (!argentinaMatch) {
  throw new Error('Geometria dell’Argentina non trovata nella mappa mondiale');
}

const argentinaGeometry = argentinaMatch[0]
  .replace('<title>Argentina</title>', '')
  .replace('<g id="ar"', '<g class="argentina-route-map__country"');

const stopPositions: Record<string, { x: number; y: number; labelX: number; labelY: number }> = {
  'buenos-aires': { x: 900, y: 952, labelX: 854, labelY: 936 },
  'el-calafate': { x: 812, y: 1100, labelX: 823, labelY: 1117 },
  'el-chalten': { x: 807, y: 1082, labelX: 817, labelY: 1073 },
  ushuaia: { x: 868, y: 1161, labelX: 829, labelY: 1185 },
};

const mappedStops = stops
  .map((stop, index) => ({ ...stop, index: index + 1, ...stopPositions[stop.slug] }))
  .filter((stop) => Number.isFinite(stop.x));
const outwardRoute = mappedStops.map(({ x, y }) => `${x},${y}`).join(' ');
---

<section class="argentina-route-map" aria-labelledby="argentina-route-map-title">
  <div class="argentina-route-map__inner container--wide">
    <header class="argentina-route-map__header">
      <p class="eyebrow">Argentina, da nord a sud</p>
      <h2 id="argentina-route-map-title">Il viaggio sulla mappa</h2>
      <p>
        Dall’arrivo a Buenos Aires fino alla Terra del Fuoco, passando per i
        ghiacciai e le montagne della Patagonia.
      </p>
    </header>

    <div class="argentina-route-map__visual">
      <svg
        viewBox="760 885 190 315"
        role="img"
        aria-labelledby="argentina-map-svg-title argentina-map-svg-description"
      >
        <title id="argentina-map-svg-title">Itinerario del viaggio in Argentina</title>
        <desc id="argentina-map-svg-description">
          Percorso schematico da Buenos Aires a El Calafate, El Chaltén e
          Ushuaia, con ritorno finale a Buenos Aires.
        </desc>

        <g set:html={argentinaGeometry} />

        <polyline class="argentina-route-map__route" points={outwardRoute} />
        <path
          class="argentina-route-map__return"
          d="M 868 1161 C 948 1118, 956 1015, 900 952"
        />

        {
          mappedStops.map((stop) => (
            <g class="argentina-route-map__stop">
              <circle cx={stop.x} cy={stop.y} r="7" />
              <text x={stop.x} y={stop.y + 2.4} text-anchor="middle">
                {stop.index}
              </text>
              <text class="argentina-route-map__label" x={stop.labelX} y={stop.labelY}>
                {stop.name}
              </text>
            </g>
          ))
        }
      </svg>
    </div>

    <div class="argentina-route-map__details">
      <ol aria-label="Tappe dell’itinerario">
        {stops.map((stop) => <li><a href={`#${stop.slug}`}>{stop.name}</a></li>)}
      </ol>
      <p><span aria-hidden="true"></span> Rientro a Buenos Aires</p>
    </div>

    <p class="argentina-route-map__note">Rappresentazione schematica, non in scala.</p>
  </div>
</section>

<style>
  .argentina-route-map {
    padding-block: var(--space-section);
  }

  .argentina-route-map__inner {
    display: grid;
    gap: var(--space-7);
  }

  .argentina-route-map__header {
    max-inline-size: var(--content-narrow);
  }

  .argentina-route-map__header h2 {
    margin-block-start: var(--space-2);
  }

  .argentina-route-map__header > p:last-child {
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .argentina-route-map__visual {
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
  }

  .argentina-route-map__visual svg {
    display: block;
    inline-size: 100%;
    max-block-size: 46rem;
  }

  .argentina-route-map__visual :global(.argentina-route-map__country path) {
    fill: var(--color-primary-soft);
    stroke: var(--color-on-primary-border);
    stroke-width: 0.8;
  }

  .argentina-route-map__route,
  .argentina-route-map__return {
    fill: none;
    stroke: var(--color-surface);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .argentina-route-map__route {
    stroke-width: 2.5;
  }

  .argentina-route-map__return {
    opacity: 0.72;
    stroke-dasharray: 6 7;
    stroke-width: 1.5;
  }

  .argentina-route-map__stop circle {
    fill: var(--color-accent);
    stroke: var(--color-surface);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .argentina-route-map__stop text {
    fill: var(--color-surface);
    font-family: var(--font-family-sans);
    font-size: 6px;
    font-weight: var(--font-weight-bold);
  }

  .argentina-route-map__stop .argentina-route-map__label {
    font-family: var(--font-family-display);
    font-size: 8px;
    paint-order: stroke;
    stroke: var(--color-primary);
    stroke-linejoin: round;
    stroke-width: 3px;
  }

  .argentina-route-map__details {
    display: grid;
    gap: var(--space-5);
  }

  .argentina-route-map__details ol {
    display: grid;
    gap: var(--space-3);
    counter-reset: map-stops;
  }

  .argentina-route-map__details li {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    counter-increment: map-stops;
  }

  .argentina-route-map__details li::before {
    display: grid;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    flex: none;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-surface);
    content: counter(map-stops);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
  }

  .argentina-route-map__details a {
    min-block-size: 2.75rem;
    align-content: center;
    font-weight: var(--font-weight-semibold);
  }

  .argentina-route-map__details p {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    color: var(--color-text-muted);
  }

  .argentina-route-map__details p span {
    inline-size: 2rem;
    border-block-start: 2px dashed var(--color-primary);
  }

  .argentina-route-map__note {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  @media (min-width: 48rem) {
    .argentina-route-map__details {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .argentina-route-map__details ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .argentina-route-map__inner {
      grid-template-columns: minmax(16rem, 0.6fr) minmax(0, 1.4fr);
      grid-template-areas:
        'header visual'
        'details visual'
        'note visual';
      align-items: start;
    }

    .argentina-route-map__header { grid-area: header; }
    .argentina-route-map__visual { grid-area: visual; }
    .argentina-route-map__details { grid-area: details; grid-template-columns: 1fr; }
    .argentina-route-map__details ol { grid-template-columns: 1fr; }
    .argentina-route-map__note { grid-area: note; }
  }
</style>
