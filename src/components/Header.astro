---
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) =>
  path === '/' ? baseUrl : `${baseUrl}${path.replace(/^\//, '')}`;

const navigationItems = [
  { label: 'Home', href: '/' },
  { label: 'Lavoro', href: '/lavoro' },
  { label: 'Viaggi', href: '/viaggi' },
  { label: 'Contatti', href: '/contatti' },
].map((item) => ({ ...item, href: withBase(item.href) }));

const externalLinks = [
  { label: 'GitHub', href: 'https://github.com/lucapapale81b' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/lucapapale' },
];

const normalizePath = (path: string) =>
  path === '/' ? path : path.replace(/\/+$/, '');

const currentPath = normalizePath(Astro.url.pathname);
---

<header class="site-header">
  <div class="site-header__inner container">
    <a
      class="site-header__identity"
      href={baseUrl}
      aria-label="Luca Papale, pagina iniziale"
    >
      <span class="site-header__name">Luca Papale</span>
      <span class="site-header__tagline">Software Developer · Traveler</span>
    </a>

    <nav aria-label="Navigazione principale">
      <ul class="site-header__navigation" role="list">
        {
          navigationItems.map((item) => {
            const isCurrent = currentPath === normalizePath(item.href);

            return (
              <li>
                <a
                  class="site-header__link"
                  href={item.href}
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <nav class="site-header__external" aria-label="Profili esterni">
      <ul class="site-header__external-links" role="list">
        {
          externalLinks.map((item) => (
            <li>
              <a href={item.href} rel="me noreferrer">{item.label}</a>
            </li>
          ))
        }
        <li>
          <span>
            Email <span class="visually-hidden">(collegamento in preparazione)</span>
          </span>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-background);
  }

  .site-header__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .site-header__identity {
    display: inline-flex;
    align-self: flex-start;
    flex-direction: column;
    color: var(--color-text);
    line-height: var(--line-height-heading);
    text-decoration: none;
  }

  .site-header__identity:hover {
    color: var(--color-primary);
  }

  .site-header__name {
    font-family: var(--font-family-display);
    font-size: clamp(1.375rem, 1.25rem + 0.4vw, 1.625rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-tight);
  }

  .site-header__tagline {
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.02em;
  }

  .site-header__navigation {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  .site-header__link {
    display: inline-flex;
    min-block-size: 2.75rem;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .site-header__link:hover {
    color: var(--color-primary);
  }

  .site-header__link[aria-current='page'] {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 0.125rem;
    text-underline-offset: 0.4rem;
  }

  .site-header__external-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .site-header__external-links a,
  .site-header__external-links span {
    display: inline-flex;
    min-block-size: 2.75rem;
    align-items: center;
  }

  .site-header__external-links a {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .site-header__external-links a:hover {
    color: var(--color-primary);
  }

  @media (min-width: 48rem) {
    .site-header__inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(var(--space-6), 5vw, var(--space-8));
      padding-block: var(--space-5);
    }

    .site-header__navigation {
      justify-content: flex-start;
      gap: var(--space-5);
    }

    .site-header__external {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  @media (min-width: 64rem) {
    .site-header__inner {
      grid-template-columns: auto auto minmax(0, 1fr);
    }

    .site-header__external {
      grid-column: auto;
      justify-self: end;
    }
  }
</style>
