---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle: string;
  description: string;
  flag: string;
  image: {
    src: ImageMetadata;
    alt: string;
  };
  href: string;
}

const { title, subtitle, description, flag, image, href } = Astro.props;
---

<article class="travel-card">
  <Image
    class="travel-card__image"
    src={image.src}
    alt={image.alt}
    widths={[480, 720]}
    sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 50vw, 100vw"
    format="webp"
    quality={85}
    loading="lazy"
  />

  <div class="travel-card__content">
    <h3>
      <a href={href}>
        <span>{title}</span>
        <img class="travel-card__flag" src={flag} alt="" width="30" height="20" />
      </a>
    </h3>
    <p class="travel-card__subtitle">{subtitle}</p>
    <p class="travel-card__description">{description}</p>
  </div>
</article>

<style>
  .travel-card {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .travel-card__image {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .travel-card__content {
    display: grid;
    gap: var(--space-2);
  }

  .travel-card h3 {
    font-size: var(--font-size-2xl);
  }

  .travel-card h3 a {
    display: inline-grid;
    gap: var(--space-2);
    justify-items: start;
    color: var(--color-text);
    text-decoration-color: transparent;
  }

  .travel-card__flag {
    inline-size: 1.5rem;
    block-size: 1rem;
    border: var(--border-width) solid rgb(23 33 43 / 0.12);
    border-radius: 0.125rem;
  }

  .travel-card h3 a:hover {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }

  .travel-card__subtitle {
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .travel-card__description {
    color: var(--color-text-muted);
  }
</style>
